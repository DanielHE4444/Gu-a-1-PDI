% PUNTO 1 
clc;
clear;
close all;

% Matriz original
A = [2 5 4 1 2 3;
    5 5 4 3 3 2;
    1 2 2 2 1 1;
    7 7 7 2 1 0];

% Factor K
K = 2;

% Reducir la resolución de gris
Ar = floor(A/K);


disp('Matriz original:');
disp(A);


disp('Matriz con resolución de gris reducida:');
disp(Ar);

figure;

subplot(1,2,1);
imagesc(A);
colormap(gray);
colorbar;
title('Imagen original');
axis image;

subplot(1,2,2);
imagesc(Ar);
colormap(gray);
colorbar;
title('Resolución de gris reducida K=2');
axis image;

