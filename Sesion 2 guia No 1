%% ROTACION

clc;
clear;
close all;

A = [2 5 4 1 2 3;
    5 5 4 3 3 2;
    1 2 2 2 1 1;
    7 7 7 2 1 0];

% Angulo
angulo = 30;

% Convertir a radianes
theta = deg2rad(angulo);

% Matriz de rotación
T = [cos(theta) -sin(theta);
    sin(theta)  cos(theta)];

% Sin traslación
tx = 0;
ty = 0;

% Aplicar transformación
B = transformacionAfin(A,T,tx,ty);

% Mostrar
figure;

subplot(1,2,1);
imagesc(A);
colormap(gray);
colorbar;
title('Original');
axis image;

subplot(1,2,2);
imagesc(B);
colormap(gray);
colorbar;
title('Rotación 30 grados');
axis image;

