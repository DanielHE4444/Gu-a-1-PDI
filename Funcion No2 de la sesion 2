function B = transformacionAfin(A,T,tx,ty)

   
    [filas,columnas] = size(A);

    
    B = zeros(filas,columnas);

  
    for y = 1:filas
        for x = 1:columnas

     
            coordenadas = [x; y];


            nuevas = T * coordenadas;

  
            x2 = round(nuevas(1) + tx);
            y2 = round(nuevas(2) + ty);

            if x2 >= 1 && x2 <= columnas && ...
               y2 >= 1 && y2 <= filas

                B(y2,x2) = A(y,x);

            end

        end
    end

end
